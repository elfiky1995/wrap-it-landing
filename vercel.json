{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/elfiky1995/wrap-it-landing/releases/latest/download/wrap-it.apk",
      "permanent": false
    },
    {
      "source": "/download-32bit",
      "destination": "https://github.com/elfiky1995/wrap-it-landing/releases/latest/download/wrap-it-armeabi-v7a.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
